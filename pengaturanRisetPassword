<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pengaturan & Reset Password - POS & Manajemen Toko</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-[#FAF7F2] min-h-screen flex font-sans">
  <!-- Sidebar Lengkap Owner -->
  <aside class="w-64 bg-[#5B4636] text-[#D4C3B3] flex flex-col justify-between py-6 px-4">
    <div class="space-y-6">
      <div class="flex items-center gap-3 px-2">
        <div class="w-10 h-10 rounded-lg bg-[#8C6D53] text-white flex items-center justify-center font-bold">K</div>
        <div>
          <div class="text-white font-semibold text-sm">Kasir</div>
          <div class="text-[10px] text-stone-300 tracking-wider uppercase">MANAJEMEN TOKO</div>
        </div>
      </div>

      <nav class="space-y-1 text-xs">
        <a href="dashboard-owner.html" class="flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-[#6e5543] hover:text-white">
          <i class="fa-solid fa-border-all w-4"></i> Dashboard Utama
        </a>
        <a href="data-kategori.html" class="flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-[#6e5543] hover:text-white">
          <i class="fa-regular fa-folder w-4"></i> Data Kategori
        </a>
        <a href="data-barang.html" class="flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-[#6e5543] hover:text-white">
          <i class="fa-solid fa-box-archive w-4"></i> Data Barang
        </a>
        <a href="transaksi-pos.html" class="flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-[#6e5543] hover:text-white">
          <i class="fa-regular fa-newspaper w-4"></i> Transaksi Kasir (POS)
        </a>
        <a href="barang-masuk.html" class="flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-[#6e5543] hover:text-white">
          <i class="fa-solid fa-truck w-4"></i> Barang Masuk & Pemasok
        </a>
        <a href="laporan-keuangan.html" class="flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-[#6e5543] hover:text-white">
          <i class="fa-solid fa-chart-column w-4"></i> Laporan Keuangan
        </a>
        <a href="arus-kas.html" class="flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-[#6e5543] hover:text-white">
          <i class="fa-solid fa-right-left w-4"></i> Arus Kas (Keluar/Masuk)
        </a>
        <a href="kelola-kasir.html" class="flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-[#6e5543] hover:text-white">
          <i class="fa-solid fa-users w-4"></i> Pengelolaan Data Kasir
        </a>
        <a href="pengaturan.html" class="flex items-center gap-3 px-3 py-2.5 rounded-lg bg-[#7A604D] text-white font-medium">
          <i class="fa-solid fa-gear w-4"></i> Pengaturan & Reset Password
        </a>
      </nav>
    </div>

    <div class="text-[11px] px-2 flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
      <div>
        <span class="text-white font-medium">Sistem normal</span><br>
        <span class="text-[10px]">Versi 1.0.0</span>
      </div>
    </div>
  </aside>

  <!-- Konten Utama Owner -->
  <main class="flex-1 flex flex-col">
    <header class="h-16 bg-white border-b border-stone-200 px-8 flex items-center justify-between">
      <div>
        <h2 class="text-xs font-bold text-stone-800">Pengaturan & Reset Password</h2>
        <p class="text-[10px] text-stone-400">Kasir • Bandung</p>
      </div>
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-full bg-[#8C6D53] text-white flex items-center justify-center text-xs font-bold">NE</div>
        <div class="text-xs text-right">
          <p class="font-semibold text-stone-800 leading-tight">Nabila El-Sholeha</p>
          <span class="text-[10px] text-stone-400">Owner (Admin)</span>
        </div>
      </div>
    </header>

    <div class="p-8 space-y-6 overflow-y-auto">
      <div>
        <h1 class="text-xl font-bold text-stone-800">Pengaturan & Reset Password</h1>
        <p class="text-xs text-stone-500 mt-1">Kelola keamanan akun Anda dan reset password kasir jika diperlukan.</p>
      </div>

      <!-- Contoh Notifikasi Sukses (Opsional untuk preview tampilan) -->
      <div id="alert-box" class="hidden bg-emerald-50 border border-emerald-200 text-emerald-700 px-4 py-3 rounded-xl text-xs flex items-center gap-2">
        <i class="fa-solid fa-circle-check"></i>
        <span id="alert-message">Password berhasil diperbarui!</span>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Form 1: Ganti Password Owner Sendiri -->
        <div class="bg-white p-6 rounded-xl border border-stone-200">
          <div class="mb-4">
            <h3 class="font-bold text-sm text-stone-800">Ganti Password Akun Saya</h3>
            <p class="text-[11px] text-stone-400">Pastikan menggunakan kombinasi minimal 8 karakter.</p>
          </div>

          <form action="#" method="POST" onsubmit="event.preventDefault(); showAlert('Password akun Anda berhasil diperbarui!');" class="space-y-4 text-xs">
            <div>
              <label class="block text-stone-600 font-medium mb-1">Password Lama</label>
              <input type="password" name="current_password" required placeholder="••••••••"
                     class="w-full px-3 py-2 rounded-lg border border-stone-200 focus:outline-none focus:border-[#8C6D53]">
            </div>

            <div>
              <label class="block text-stone-600 font-medium mb-1">Password Baru</label>
              <input type="password" name="password" required placeholder="Minimal 8 karakter"
                     class="w-full px-3 py-2 rounded-lg border border-stone-200 focus:outline-none focus:border-[#8C6D53]">
            </div>

            <div>
              <label class="block text-stone-600 font-medium mb-1">Konfirmasi Password Baru</label>
              <input type="password" name="password_confirmation" required placeholder="Ulangi password baru"
                     class="w-full px-3 py-2 rounded-lg border border-stone-200 focus:outline-none focus:border-[#8C6D53]">
            </div>

            <button type="submit" class="bg-[#5B4636] hover:bg-[#49372a] text-white font-medium px-4 py-2.5 rounded-lg transition">
              Simpan Password Baru
            </button>
          </form>
        </div>

        <!-- Form 2: Reset Password Kasir -->
        <div class="bg-white p-6 rounded-xl border border-stone-200">
          <div class="mb-4">
            <h3 class="font-bold text-sm text-stone-800">Reset Password Kasir</h3>
            <p class="text-[11px] text-stone-400">Gunakan fitur ini jika petugas kasir lupa password login mereka.</p>
          </div>

          <div class="space-y-3">
            <!-- Contoh Item Kasir 1 -->
            <form action="#" method="POST" onsubmit="event.preventDefault(); showAlert('Password untuk Siti Aminah berhasil direset!');"
                  class="p-3 rounded-lg border border-stone-100 bg-[#FAF7F2] flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
              <div>
                <p class="font-semibold text-stone-800">Siti Aminah</p>
                <span class="text-[10px] text-stone-400">siti.kasir@toko.com</span>
              </div>

              <div class="flex items-center gap-2">
                <input type="text" name="new_password" placeholder="Password baru..." required
                       class="px-2.5 py-1.5 rounded border border-stone-200 bg-white text-xs w-36 focus:outline-none focus:border-[#8C6D53]">
                <button type="submit" class="bg-[#8C6D53] hover:bg-[#755a44] text-white px-3 py-1.5 rounded font-medium transition">
                  Reset
                </button>
              </div>
            </form>

            <!-- Contoh Item Kasir 2 -->
            <form action="#" method="POST" onsubmit="event.preventDefault(); showAlert('Password untuk Budi Santoso berhasil direset!');"
                  class="p-3 rounded-lg border border-stone-100 bg-[#FAF7F2] flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
              <div>
                <p class="font-semibold text-stone-800">Budi Santoso</p>
                <span class="text-[10px] text-stone-400">budi.kasir@toko.com</span>
              </div>

              <div class="flex items-center gap-2">
                <input type="text" name="new_password" placeholder="Password baru..." required
                       class="px-2.5 py-1.5 rounded border border-stone-200 bg-white text-xs w-36 focus:outline-none focus:border-[#8C6D53]">
                <button type="submit" class="bg-[#8C6D53] hover:bg-[#755a44] text-white px-3 py-1.5 rounded font-medium transition">
                  Reset
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </main>

  <script>
    function showAlert(msg) {
      const box = document.getElementById('alert-box');
      document.getElementById('alert-message').textContent = msg;
      box.classList.remove('hidden');
    }
  </script>
</body>
</html>